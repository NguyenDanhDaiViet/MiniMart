<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <Compile Update="**\*.Designer.cs">
            <DependentUpon>$([System.String]::Copy('%(Filename)').Replace('.Designer', '')).cs</DependentUpon>
        </Compile>
        <Compile Update="Forms\FormBanHang.cs">
          <SubType>Form</SubType>
        </Compile>
        <Compile Update="Forms\FormThongTinTaiKhoan.cs">
          <SubType>Form</SubType>
        </Compile>
        <Compile Update="Forms\FormLichSuDonHang.cs">
          <SubType>Form</SubType>
        </Compile>
        <Compile Update="Forms\FormDangNhap.cs">
          <SubType>Form</SubType>
        </Compile>
        <Compile Update="Forms\FormTopSanPham.cs">
          <SubType>Form</SubType>
        </Compile>
        <Compile Update="Forms\FormHanSuDungcs.cs">
          <SubType>Form</SubType>
        </Compile>
        <Compile Update="Forms\FormKhachHang.cs">
          <SubType>Form</SubType>
        </Compile>
        <Compile Update="Forms\FormKhuyenMai.cs">
          <SubType>Form</SubType>
        </Compile>
        <Compile Update="Forms\FormLichSuHoatDong.cs">
          <SubType>Form</SubType>
        </Compile>
        <Compile Update="Forms\FormLichSuNhapKho.cs">
          <SubType>Form</SubType>
        </Compile>
        <Compile Update="Forms\FormQuanLyCa.cs">
          <SubType>Form</SubType>
        </Compile>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    </ItemGroup>

</Project>